{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quark",
  "version": "0.1.0",
  "identifier": "com.quarkdown.quark",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quark",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": "all"
  },
  "plugins": {
    "shell": { "open": true },
    "fs":    { "scope": { "allow": [{ "path": "$APPDATA/**" }] } }
  }
}
